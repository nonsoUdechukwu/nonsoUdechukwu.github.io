---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import { TOPICS } from '../../config';
import { getPosts, getTags, slugify, type Post } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = getTags(posts);
  const paths = tags.map((tag) => ({
    params: { tag: tag.slug },
    props: { name: tag.name, posts: posts.filter((p) => p.data.tags.some((t) => slugify(t) === tag.slug)) },
  }));
  // Ensure every home-page topic link resolves, even before a post uses that tag.
  for (const topic of TOPICS) {
    if (!tags.some((t) => t.slug === topic.tag)) {
      paths.push({ params: { tag: topic.tag }, props: { name: topic.name, posts: [] } });
    }
  }
  return paths;
}

interface Props {
  name: string;
  posts: Post[];
}
const { name, posts } = Astro.props;
---

<BaseLayout title={`#${name}`} description={`Articles tagged with ${name}.`}>
  <div class="container tag-page">
    <header class="page-header">
      <a href="/tags" class="back-link">← All tags</a>
      <h1 class="page-title"><span class="hash">#</span><span class="gradient-text">{name}</span></h1>
      <p class="page-description">
        <span class="count">{String(posts.length).padStart(2, '0')}</span>
        {posts.length === 1 ? 'article' : 'articles'} tagged
      </p>
    </header>
    {posts.length > 0 ? (
      <div class="posts-grid">
        {posts.map((post) => <BlogCard post={post} />)}
      </div>
    ) : (
      <div class="empty">
        <p class="empty-title">Nothing here yet.</p>
        <p>Articles on {name} are on the way — check back soon.</p>
        <a href="/blog" class="btn btn-secondary">Browse all posts</a>
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .tag-page { padding-top: 4rem; }
  .page-header { margin-bottom: 2.5rem; }
  .back-link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 1.25rem;
  }
  .back-link:hover { color: var(--color-primary); }
  .page-title {
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 0.75rem;
  }
  .hash { color: var(--color-text-muted); font-weight: 500; margin-right: 0.15rem; }
  .page-description {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0;
  }
  .count {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--color-primary);
  }
  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }
  .empty {
    padding: 3.5rem 1.5rem;
    text-align: center;
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius-xl);
    color: var(--color-text-muted);
    background: radial-gradient(ellipse at 50% 0%, var(--color-tag-bg), transparent 70%);
  }
  .empty-title {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.4rem;
  }
  .empty .btn { margin-top: 0.75rem; }
  @media (max-width: 480px) {
    .posts-grid { grid-template-columns: 1fr; }
  }
</style>
