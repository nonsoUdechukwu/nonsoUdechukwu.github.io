---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found">
  <div class="container not-found">
    <div class="eye" aria-hidden="true">
      <span class="ring"></span>
      <img src="/images/logo-eye.jpg" alt="" width="160" height="160" />
    </div>
    <p class="eyebrow">Error 404</p>
    <h1>Signal <span class="gradient-text">lost</span>.</h1>
    <p class="lead">The page you're looking for doesn't exist or has moved.</p>
    <div class="terminal">
      <span class="prompt">$</span> curl -I <span id="missing-path">/</span>
      <br /><span class="err">HTTP/1.1 404 Not Found</span>
    </div>
    <div class="actions">
      <a href="/" class="btn btn-primary">Go home</a>
      <a href="/blog" class="btn btn-secondary">Browse the blog</a>
    </div>
  </div>
</BaseLayout>

<script>
  document.addEventListener('astro:page-load', () => {
    const el = document.getElementById('missing-path');
    if (el) el.textContent = location.pathname;
  });
</script>

<style>
  .not-found {
    padding: 5rem 1.5rem 2rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .eye {
    position: relative;
    width: 140px;
    aspect-ratio: 1;
    margin-bottom: 2rem;
  }
  .eye img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    background: #10141b;
    filter: grayscale(0.6) brightness(0.8);
    box-shadow: var(--glow);
  }
  .ring {
    position: absolute;
    inset: -10px;
    border-radius: 50%;
    border: 1px dashed color-mix(in srgb, var(--color-danger) 60%, transparent);
    animation: spin 30s linear infinite;
  }
  h1 {
    font-size: clamp(2.4rem, 6vw, 3.6rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin: 0.8rem 0 0.6rem;
  }
  .lead { color: var(--color-text-muted); margin-bottom: 1.75rem; }
  .terminal {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    text-align: left;
    background: var(--color-code-bg);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1rem 1.25rem;
    margin-bottom: 2rem;
    max-width: 100%;
    overflow-x: auto;
  }
  .prompt { color: var(--color-success); font-weight: 600; }
  .err { color: var(--color-danger); font-weight: 600; }
  .actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }
</style>
