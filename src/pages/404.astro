---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found">
  <div class="container not-found">
    <div class="terminal">
      <span class="prompt">$</span> curl -I {Astro.url.pathname}
      <br /><span class="err">HTTP/1.1 404 Not Found</span>
    </div>
    <h1>Page not found</h1>
    <p>The page you're looking for doesn't exist or has moved.</p>
    <div class="actions">
      <a href="/" class="btn btn-primary">Go Home</a>
      <a href="/blog" class="btn btn-secondary">Browse the Blog</a>
    </div>
  </div>
</BaseLayout>

<style>
  .not-found {
    padding: 6rem 1.5rem 2rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .terminal {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    text-align: left;
    background: #0d1117;
    color: #c9d1d9;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1rem 1.25rem;
    margin-bottom: 2rem;
    max-width: 100%;
    overflow-x: auto;
  }
  .prompt { color: #3fb950; font-weight: 600; }
  .err { color: #f85149; font-weight: 600; }
  h1 { margin-bottom: 0.75rem; }
  p { color: var(--color-text-muted); }
  .actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 1rem;
  }
</style>
