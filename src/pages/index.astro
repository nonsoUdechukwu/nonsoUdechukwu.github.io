---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogCard from '../components/BlogCard.astro';
import Icon from '../components/Icon.astro';
import { AUTHOR, SOCIALS, TOPICS } from '../config';
import { getPosts, getTags } from '../utils/posts';

const posts = await getPosts();
const [featured, ...rest] = posts;
const more = rest.slice(0, 4);
const tags = getTags(posts);
const orbitChips = ['Azure', 'Kubernetes', 'IaC', 'AI'];
---

<BaseLayout>
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-content animate-fade-in">
        <p class="eyebrow">{AUTHOR.role}</p>
        <h1 class="hero-title">
          Building <span class="gradient-text">intelligent platforms</span> for the cloud.
        </h1>
        <p class="hero-description">
          I'm <strong>{AUTHOR.fullName}</strong> — a {AUTHOR.title} writing hands-on guides on AI, Azure,
          Kubernetes, Infrastructure as Code and the home lab where I test it all.
        </p>
        <div class="hero-actions">
          <a href="/blog" class="btn btn-primary">
            Explore articles <Icon name="arrow-right" size={16} />
          </a>
          <a href="/about" class="btn btn-secondary">About me</a>
        </div>
        <dl class="hero-stats">
          <div class="stat">
            <dt>{posts.length === 1 ? 'Article' : 'Articles'}</dt>
            <dd>{String(posts.length).padStart(2, '0')}</dd>
          </div>
          <div class="stat">
            <dt>{tags.length === 1 ? 'Topic' : 'Topics'}</dt>
            <dd>{String(tags.length).padStart(2, '0')}</dd>
          </div>
          <div class="stat">
            <dt>Years in tech</dt>
            <dd>{AUTHOR.yearsExperience}</dd>
          </div>
        </dl>
      </div>

      <div class="hero-visual" aria-hidden="true">
        <div class="orb">
          <span class="ring ring-1"></span>
          <span class="ring ring-2"></span>
          <span class="ring ring-3"></span>
          <div class="orb-core">
            <img src="/images/logo-eye.jpg" alt="" width="900" height="650" />
          </div>
          {orbitChips.map((chip, i) => <span class={`chip chip-${i + 1}`}>{chip}</span>)}
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <header class="section-header">
        <div>
          <p class="eyebrow">Focus areas</p>
          <h2 class="section-title">What I write about</h2>
        </div>
        <a href="/tags" class="section-link">Browse all tags <Icon name="arrow-right" size={14} /></a>
      </header>
      <div class="topics-grid">
        {TOPICS.map((topic, i) => (
          <a href={`/tags/${topic.tag}`} class:list={['topic-card', { 'topic-card--featured': topic.featured }]}>
            <div class="topic-top">
              <span class="topic-icon"><Icon name={topic.icon} size={20} /></span>
              <span class="topic-index">{String(i + 1).padStart(2, '0')}</span>
            </div>
            <h3 class="topic-name">{topic.name}</h3>
            <p class="topic-desc">{topic.desc}</p>
            <span class="topic-arrow"><Icon name="arrow-up-right" size={16} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <header class="section-header">
        <div>
          <p class="eyebrow">Latest writing</p>
          <h2 class="section-title">Fresh from the blog</h2>
        </div>
        <a href="/blog" class="section-link">All articles <Icon name="arrow-right" size={14} /></a>
      </header>
      {featured ? (
        <div class="posts-layout">
          <BlogCard post={featured} featured />
          {more.length > 0 && <div class="posts-grid">{more.map((post) => <BlogCard post={post} />)}</div>}
        </div>
      ) : (
        <p class="empty">No posts yet — check back soon.</p>
      )}
    </div>
  </section>

  <section class="section cta-section">
    <div class="container">
      <div class="cta-panel">
        <div class="cta-content">
          <p class="eyebrow">Stay in the loop</p>
          <h2 class="cta-title">Signal, not noise.</h2>
          <p class="cta-description">
            New deep-dives on AI, platform engineering and DevOps land in the RSS feed the moment they're published.
          </p>
          <div class="cta-actions">
            <a href="/rss.xml" class="btn btn-primary"><Icon name="rss" size={16} /> Subscribe via RSS</a>
            <a href={SOCIALS.github} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
              <Icon name="github" size={16} /> GitHub
            </a>
          </div>
        </div>
        <div class="cta-art" aria-hidden="true">
          <img src="/images/logo-eye.jpg" alt="" width="900" height="650" loading="lazy" />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    position: relative;
    padding: 5.5rem 0 4.5rem;
    overflow: hidden;
  }
  .hero-inner {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 3.5rem;
    align-items: center;
  }
  .hero-title {
    font-size: clamp(2.2rem, 5.2vw, 3.6rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.03em;
    margin: 1.1rem 0 1.4rem;
  }
  .hero-description {
    font-size: 1.12rem;
    color: var(--color-text-muted);
    max-width: 52ch;
    margin-bottom: 2.2rem;
  }
  .hero-description strong { color: var(--color-text); font-weight: 600; }
  .hero-actions {
    display: flex;
    gap: 0.85rem;
    flex-wrap: wrap;
    margin-bottom: 2.75rem;
  }
  .hero-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    max-width: 460px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--color-bg-card) 65%, transparent);
    overflow: hidden;
  }
  .stat {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.3rem;
    padding: 0.95rem 1.1rem;
  }
  .stat + .stat { border-left: 1px solid var(--color-border); }
  .stat dd {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 800;
    line-height: 1;
    background: var(--gradient-brand);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .stat dt {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  /* Orb visual built around the logo */
  .hero-visual {
    display: flex;
    justify-content: center;
  }
  .orb {
    position: relative;
    width: min(440px, 82vw);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
  }
  .orb::before {
    content: '';
    position: absolute;
    inset: 12%;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--color-primary) 35%, transparent), transparent 70%);
    filter: blur(30px);
  }
  .ring {
    position: absolute;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--color-primary) 30%, transparent);
  }
  .ring-1 { inset: 0; border-style: dashed; animation: spin 60s linear infinite; }
  .ring-2 {
    inset: 8%;
    border-color: transparent;
    border-top-color: var(--color-primary);
    border-right-color: color-mix(in srgb, var(--color-blue) 70%, transparent);
    animation: spin 14s linear infinite reverse;
  }
  .ring-3 { inset: 16%; border-color: color-mix(in srgb, var(--color-teal) 25%, transparent); }
  .orb-core {
    position: relative;
    width: 66%;
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    background: #10141b;
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--color-primary) 40%, transparent), 0 30px 80px -20px rgba(34, 211, 238, 0.55);
  }
  .orb-core img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.25);
  }
  .chip {
    position: absolute;
    padding: 0.35rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--color-text);
    background: color-mix(in srgb, var(--color-bg-card) 85%, transparent);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    backdrop-filter: blur(6px);
    box-shadow: var(--shadow-md);
    animation: float 6s ease-in-out infinite;
  }
  .chip::before {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 0.45rem;
    border-radius: 50%;
    background: var(--color-primary);
    box-shadow: 0 0 8px var(--color-primary);
    vertical-align: middle;
  }
  .chip-1 { top: 10%; left: 2%; }
  .chip-2 { top: 18%; right: -2%; animation-delay: -1.5s; }
  .chip-3 { bottom: 16%; left: -3%; animation-delay: -3s; }
  .chip-4 { bottom: 8%; right: 8%; animation-delay: -4.5s; }
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  /* Section headers */
  .section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 2.25rem;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .section-title {
    font-size: clamp(1.6rem, 3.2vw, 2.2rem);
    font-weight: 800;
    margin-top: 0.6rem;
  }
  .section-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    padding-bottom: 0.2rem;
    border-bottom: 1px solid var(--color-border-strong);
  }
  .section-link:hover { color: var(--color-primary); border-color: var(--color-primary); }

  /* Topics */
  .topics-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }
  .topic-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.4rem;
    background: color-mix(in srgb, var(--color-bg-card) 80%, transparent);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    color: var(--color-text);
    overflow: hidden;
    transition: all var(--transition);
  }
  .topic-card::after {
    content: '';
    position: absolute;
    inset: auto -30% -60% auto;
    width: 70%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--color-primary) 22%, transparent), transparent 70%);
    opacity: 0;
    transition: opacity var(--transition);
  }
  .topic-card:hover {
    color: var(--color-text);
    border-color: color-mix(in srgb, var(--color-primary) 50%, var(--color-border));
    transform: translateY(-3px);
  }
  .topic-card:hover::after { opacity: 1; }
  .topic-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.6rem;
  }
  .topic-icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    color: var(--color-primary);
    background: var(--color-tag-bg);
    border: 1px solid color-mix(in srgb, var(--color-primary) 25%, transparent);
  }
  .topic-index {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }
  .topic-name { font-size: 1.02rem; font-weight: 700; }
  .topic-desc {
    font-size: 0.86rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.55;
  }
  .topic-arrow {
    position: absolute;
    right: 1.2rem;
    bottom: 1.2rem;
    color: var(--color-primary);
    opacity: 0;
    transform: translate(-4px, 4px);
    transition: all var(--transition);
  }
  .topic-card:hover .topic-arrow { opacity: 1; transform: none; }
  .topic-card--featured {
    grid-column: span 2;
    background:
      radial-gradient(ellipse at 100% 0%, color-mix(in srgb, var(--color-primary) 16%, transparent), transparent 60%),
      color-mix(in srgb, var(--color-bg-card) 85%, transparent);
    border-color: color-mix(in srgb, var(--color-primary) 35%, var(--color-border));
  }
  .topic-card--featured .topic-icon {
    background: var(--gradient-button);
    color: var(--color-on-primary);
    border: none;
  }
  .topic-card--featured .topic-name { font-size: 1.25rem; }

  /* Posts */
  .posts-layout {
    display: grid;
    gap: 1.5rem;
  }
  .posts-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }
  .empty { color: var(--color-text-muted); }

  /* CTA */
  .cta-section { padding-top: 1rem; }
  .cta-panel {
    position: relative;
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    align-items: center;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background:
      radial-gradient(ellipse at 0% 100%, color-mix(in srgb, var(--color-blue) 14%, transparent), transparent 55%),
      var(--color-bg-card);
    overflow: hidden;
  }
  .cta-content {
    position: relative;
    z-index: 1;
    padding: 3.25rem;
  }
  .cta-title {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 800;
    margin: 0.75rem 0 1rem;
  }
  .cta-description {
    color: var(--color-text-muted);
    font-size: 1.05rem;
    max-width: 46ch;
    margin-bottom: 2rem;
  }
  .cta-actions {
    display: flex;
    gap: 0.85rem;
    flex-wrap: wrap;
  }
  .cta-art {
    align-self: stretch;
    position: relative;
    background: #10141b;
    min-height: 280px;
  }
  .cta-art img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cta-art::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(90deg, var(--color-bg-card) 0%, transparent 45%);
  }

  @media (max-width: 1024px) {
    .topics-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 860px) {
    .hero { padding: 3.5rem 0 3rem; }
    .hero-inner { grid-template-columns: 1fr; gap: 3rem; }
    .hero-visual { order: -1; }
    .orb { width: min(320px, 78vw); }
    .cta-panel { grid-template-columns: 1fr; }
    .cta-art { min-height: 200px; order: -1; }
    .cta-art::before { background: linear-gradient(0deg, var(--color-bg-card) 0%, transparent 60%); }
    .cta-content { padding: 2rem 1.5rem 2.5rem; }
  }
  @media (max-width: 600px) {
    .topics-grid,
    .posts-grid { grid-template-columns: 1fr; }
    .topic-card--featured { grid-column: auto; }
    .chip { font-size: 0.65rem; }
  }
</style>
