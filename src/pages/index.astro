---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogCard from '../components/BlogCard.astro';
import Icon from '../components/Icon.astro';
import { AUTHOR, SOCIALS, TOPICS } from '../config';
import { getPosts, getTags } from '../utils/posts';

const posts = await getPosts();
const recent = posts.slice(0, 3);
const tags = getTags(posts);
---

<BaseLayout>
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-content">
        <div class="hero-badge">
          <span class="badge-dot"></span>
          {AUTHOR.role}
        </div>
        <h1 class="hero-title">
          Hi, I'm <span class="gradient-text">{AUTHOR.name}</span>
        </h1>
        <p class="hero-description">
          I write about Azure, DevOps, Kubernetes, Platform Engineering and Infrastructure as Code. Practical,
          hands-on guides from real-world projects and my home lab.
        </p>
        <div class="hero-actions">
          <a href="/blog" class="btn btn-primary">
            <Icon name="book" size={16} /> Read the Blog
          </a>
          <a href="/about" class="btn btn-secondary">About Me</a>
        </div>
        <div class="hero-stats">
          <div class="stat">
            <span class="stat-value">{posts.length}</span>
            <span class="stat-label">{posts.length === 1 ? 'Article' : 'Articles'}</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat">
            <span class="stat-value">{tags.length}</span>
            <span class="stat-label">{tags.length === 1 ? 'Topic' : 'Topics'}</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat">
            <span class="stat-value">{AUTHOR.yearsExperience}</span>
            <span class="stat-label">Years Experience</span>
          </div>
        </div>
      </div>

      <div class="hero-visual" aria-hidden="true">
        <div class="terminal">
          <div class="terminal-header">
            <span class="dot dot-red"></span>
            <span class="dot dot-yellow"></span>
            <span class="dot dot-green"></span>
            <span class="terminal-title">nonso@homelab: ~</span>
          </div>
          <div class="terminal-body" id="termBody"></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section topics-section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">What I Write About</h2>
        <a href="/tags" class="section-link">All topics →</a>
      </div>
      <div class="topics-grid">
        {TOPICS.map((topic) => (
          <a href={`/tags/${topic.tag}`} class="topic-card">
            <div class={`topic-icon topic-icon--${topic.icon}`}>
              <Icon name={topic.icon} size={22} />
            </div>
            <div class="topic-content">
              <h3 class="topic-name">{topic.name}</h3>
              <p class="topic-desc">{topic.desc}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section recent-posts-section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Recent Posts</h2>
        <a href="/blog" class="section-link">View all →</a>
      </div>
      {recent.length > 0 ? (
        <div class="posts-grid">
          {recent.map((post) => <BlogCard post={post} />)}
        </div>
      ) : (
        <p class="empty">No posts yet — check back soon.</p>
      )}
      <div class="view-all-cta">
        <a href="/blog" class="btn btn-secondary">View All Posts</a>
      </div>
    </div>
  </section>

  <section class="section cta-section">
    <div class="container">
      <div class="cta-card">
        <div class="cta-content">
          <h2 class="cta-title">Stay Updated</h2>
          <p class="cta-description">
            Subscribe via RSS to get new articles about Azure, DevOps and Kubernetes as soon as they're published. No
            spam, just a lightweight feed.
          </p>
          <div class="cta-actions">
            <a href="/rss.xml" class="btn btn-primary">
              <Icon name="rss" size={16} /> Subscribe via RSS
            </a>
            <a href={SOCIALS.github} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
              <Icon name="github" size={16} /> Follow on GitHub
            </a>
          </div>
        </div>
        <div class="cta-decoration" aria-hidden="true">
          <div class="decoration-circle c1"></div>
          <div class="decoration-circle c2"></div>
          <div class="decoration-circle c3"></div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  type Seg = [string, string?];
  type Step = { cmd: Seg[]; out: { text: string; ok?: boolean }[] };

  const script: Step[] = [
    {
      cmd: [['az', 'th-bin'], [' login', 'th-sub'], [' --tenant', 'th-flag'], [' nonsotech', 'th-val']],
      out: [{ text: '✓ Logged in to Azure', ok: true }],
    },
    {
      cmd: [['terraform', 'th-bin'], [' apply', 'th-sub'], [' -auto-approve', 'th-flag']],
      out: [{ text: 'azurerm_kubernetes_cluster.aks: Creation complete' }, { text: 'Apply complete! Resources: 12 added.', ok: true }],
    },
    {
      cmd: [['kubectl', 'th-bin'], [' get', 'th-sub'], [' nodes', 'th-val']],
      out: [
        { text: 'aks-system-0   Ready   v1.31' },
        { text: 'aks-user-0     Ready   v1.31' },
      ],
    },
    {
      cmd: [['git', 'th-bin'], [' push', 'th-sub'], [' origin', 'th-val'], [' main', 'th-path']],
      out: [{ text: '✓ Pipeline succeeded — deployed', ok: true }],
    },
  ];

  let timer: ReturnType<typeof setTimeout> | undefined;
  const sleep = (ms: number) => new Promise<void>((r) => (timer = setTimeout(r, ms)));

  async function run(body: HTMLElement, token: { active: boolean }) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    while (token.active) {
      body.innerHTML = '';
      for (const step of script) {
        const line = document.createElement('div');
        line.className = 'terminal-line';
        line.innerHTML = '<span class="prompt">$ </span>';
        const cursor = document.createElement('span');
        cursor.className = 'cursor';
        cursor.textContent = '▋';
        line.appendChild(cursor);
        body.appendChild(line);
        for (const [text, cls] of step.cmd) {
          const span = document.createElement('span');
          if (cls) span.className = cls;
          line.insertBefore(span, cursor);
          for (const ch of text) {
            if (!token.active) return;
            span.textContent += ch;
            await sleep(reduced ? 0 : 45);
          }
        }
        await sleep(reduced ? 0 : 350);
        cursor.remove();
        for (const o of step.out) {
          const out = document.createElement('div');
          out.className = 'terminal-output' + (o.ok ? ' success' : '');
          out.textContent = o.text;
          body.appendChild(out);
          await sleep(reduced ? 0 : 180);
        }
        await sleep(reduced ? 0 : 600);
      }
      const idle = document.createElement('div');
      idle.className = 'terminal-line';
      idle.innerHTML = '<span class="prompt">$ </span><span class="cursor">▋</span>';
      body.appendChild(idle);
      if (reduced) return;
      await sleep(4000);
    }
  }

  let token = { active: false };
  document.addEventListener('astro:page-load', () => {
    token.active = false;
    clearTimeout(timer);
    const body = document.getElementById('termBody');
    if (!body) return;
    token = { active: true };
    run(body, token);
  });
</script>

<style>
  .hero {
    padding: 5rem 0 4rem;
    position: relative;
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -20%;
    width: 60%;
    height: 150%;
    background: radial-gradient(ellipse, rgba(88, 166, 255, 0.06) 0%, transparent 70%);
    pointer-events: none;
  }
  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
    position: relative;
  }
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    background: var(--color-tag-bg);
    border: 1px solid var(--color-border);
    border-radius: 100px;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-tag-text);
    margin-bottom: 1.25rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .badge-dot {
    width: 8px;
    height: 8px;
    background: var(--color-success);
    border-radius: 50%;
    animation: pulse 2s infinite;
  }
  .hero-title {
    font-size: clamp(2rem, 5vw, 3.25rem);
    line-height: 1.15;
    margin-bottom: 1.25rem;
  }
  .gradient-text {
    background: linear-gradient(135deg, var(--color-primary) 0%, #a78bfa 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .hero-description {
    font-size: 1.1rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    max-width: 50ch;
    margin-bottom: 2rem;
  }
  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
  }
  .hero-stats {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .stat-value {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-primary);
    line-height: 1;
  }
  .stat-label {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .stat-divider {
    width: 1px;
    height: 32px;
    background: var(--color-border);
  }

  .hero-visual {
    display: flex;
    justify-content: flex-end;
  }
  .terminal {
    background: #0d1117;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    width: 100%;
    max-width: 440px;
    box-shadow: var(--shadow-lg);
    font-family: var(--font-mono);
  }
  .terminal-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    background: #161b22;
    border-bottom: 1px solid #30363d;
  }
  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }
  .dot-red { background: #ff5f57; }
  .dot-yellow { background: #febc2e; }
  .dot-green { background: #28c840; }
  .terminal-title {
    margin-left: auto;
    font-size: 0.75rem;
    color: #8b949e;
  }
  .terminal-body {
    padding: 1.25rem;
    font-size: 0.8rem;
    line-height: 1.7;
    color: #c9d1d9;
    min-height: 290px;
  }
  .terminal-body :global(.terminal-line) { color: #c9d1d9; margin-top: 0.35rem; }
  .terminal-body :global(.terminal-line:first-child) { margin-top: 0; }
  .terminal-body :global(.prompt) { color: #3fb950; font-weight: 600; }
  .terminal-body :global(.terminal-output) { color: #8b949e; padding-left: 1rem; }
  .terminal-body :global(.terminal-output.success) { color: #3fb950; }
  .terminal-body :global(.th-bin) { color: #79c0ff; font-weight: 600; }
  .terminal-body :global(.th-sub) { color: #d2a8ff; }
  .terminal-body :global(.th-flag) { color: #ffa657; }
  .terminal-body :global(.th-val) { color: #a5d6ff; }
  .terminal-body :global(.th-path) { color: #7ee787; }
  .terminal-body :global(.cursor) { animation: pulse 1s step-end infinite; color: #c9d1d9; }

  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2rem;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .section-title {
    font-size: 1.75rem;
    font-weight: 800;
  }
  .section-link {
    color: var(--color-primary);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
  }
  .section-link:hover { color: var(--color-primary-hover); }

  .topics-section {
    background: var(--color-bg-secondary);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }
  .topics-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .topic-card {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.25rem;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: var(--color-text);
    transition: all var(--transition);
  }
  .topic-card:hover {
    border-color: var(--color-primary);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    color: var(--color-text);
  }
  .topic-icon {
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-md);
    color: var(--topic-color);
    background: color-mix(in srgb, var(--topic-color) 14%, transparent);
  }
  .topic-icon--azure { --topic-color: #3d8bff; }
  .topic-icon--kubernetes { --topic-color: #5b8def; }
  .topic-icon--devops { --topic-color: #3fb950; }
  .topic-icon--iac { --topic-color: #a78bfa; }
  .topic-icon--platform { --topic-color: #f0883e; }
  .topic-icon--homelab { --topic-color: #db61a2; }
  .topic-name {
    font-size: 0.95rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
  }
  .topic-desc {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.5;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  .empty { color: var(--color-text-muted); }
  .view-all-cta {
    display: flex;
    justify-content: center;
    margin-top: 2.5rem;
  }

  .cta-section { padding-top: 0; }
  .cta-card {
    position: relative;
    background: linear-gradient(135deg, var(--color-bg-secondary) 0%, var(--color-bg-card) 100%);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: 3.5rem;
    overflow: hidden;
    text-align: center;
  }
  .cta-content {
    position: relative;
    z-index: 1;
  }
  .cta-title {
    font-size: 2rem;
    margin-bottom: 1rem;
  }
  .cta-description {
    color: var(--color-text-muted);
    font-size: 1.05rem;
    max-width: 50ch;
    margin: 0 auto 2rem;
  }
  .cta-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .cta-decoration {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .decoration-circle {
    position: absolute;
    border-radius: 50%;
    opacity: 0.1;
  }
  .c1 { width: 300px; height: 300px; background: var(--color-primary); top: -150px; right: -100px; }
  .c2 { width: 200px; height: 200px; background: #a78bfa; bottom: -100px; left: -50px; }
  .c3 { width: 100px; height: 100px; background: var(--color-success); bottom: 50px; right: 15%; }

  @media (max-width: 1024px) {
    .topics-grid,
    .posts-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 768px) {
    .hero { padding: 3rem 0 2.5rem; }
    .hero-inner { grid-template-columns: 1fr; gap: 2.5rem; }
    .hero-visual { justify-content: center; }
    .topics-grid,
    .posts-grid { grid-template-columns: 1fr; }
    .cta-card { padding: 2.5rem 1.5rem; }
  }
</style>
