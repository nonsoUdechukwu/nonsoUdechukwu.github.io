---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { getCloudNativeUpdates, SERVICES, type UpdateKind } from '../utils/cloud-native-updates';

const updates = await getCloudNativeUpdates();
const builtAt = new Date();

const LABELS: Record<UpdateKind, string> = {
  ga: 'Generally available',
  preview: 'Preview',
  retirement: 'Retirement',
  update: 'Update',
};
const filters = [
  { key: 'all', label: 'All', count: updates.length },
  ...(Object.keys(LABELS) as UpdateKind[])
    .map((k) => ({ key: k, label: LABELS[k], count: updates.filter((u) => u.kind === k).length }))
    .filter((f) => f.count > 0),
];
const services = [
  { key: 'all', label: 'All services', count: updates.length },
  ...SERVICES.map((s) => ({ key: s.key, label: s.label, count: updates.filter((u) => u.services.includes(s.key)).length })).filter(
    (s) => s.count > 0,
  ),
];
const serviceLabel = Object.fromEntries(SERVICES.map((s) => [s.key, s.label]));
const AZURE_UPDATES_URL = 'https://azure.microsoft.com/updates?category=containers';

const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' });
---

<BaseLayout
  title="Cloud-Native Radar"
  description="The latest Azure cloud-native announcements — AKS, Container Apps, ACR and more — new features, previews and retirements from Azure Updates."
>
  <div class="container updates-page">
    <header class="page-header">
      <p class="eyebrow">Azure release tracker</p>
      <h1 class="page-title">Cloud-Native <span class="gradient-text">Radar</span></h1>
      <p class="page-lede">
        The latest announcements across Azure's cloud-native services — AKS, Container Apps, Container Registry,
        Fleet Manager and more. General availability, previews and retirements, sourced from{' '}
        <a href={AZURE_UPDATES_URL} target="_blank" rel="noopener noreferrer">Azure Updates</a>.
      </p>
      <p class="page-description">Refreshed daily · last sync {fmt(builtAt)}</p>
    </header>

    {updates.length === 0 ? (
      <div class="empty">
        <p>Couldn't load updates right now.</p>
        <a class="btn btn-secondary" href={AZURE_UPDATES_URL} target="_blank" rel="noopener noreferrer">
          View on Azure Updates <Icon name="arrow-up-right" size={14} />
        </a>
      </div>
    ) : (
      <>
        <div class="filters services" role="group" aria-label="Filter by service">
          {services.map((f, i) => (
            <button type="button" class="filter" data-service={f.key} aria-pressed={i === 0 ? 'true' : 'false'}>
              {f.label} <span class="filter-count">{f.count}</span>
            </button>
          ))}
        </div>
        <div class="toolbar">
          <div class="filters" role="group" aria-label="Filter by status">
            {filters.map((f, i) => (
              <button type="button" class="filter filter-sm" data-filter={f.key} aria-pressed={i === 0 ? 'true' : 'false'}>
                {f.label} <span class="filter-count">{f.count}</span>
              </button>
            ))}
          </div>
          <label class="search">
            <Icon name="search" size={15} />
            <input type="search" placeholder="Search updates…" aria-label="Search updates" data-updates-search />
          </label>
        </div>

        <ol class="updates" data-updates-list>
          {updates.map((u) => (
            <li class="update" data-kind={u.kind} data-services={u.services.join(' ')} data-text={`${u.title} ${u.summary}`.toLowerCase()}>
              <a href={u.url} target="_blank" rel="noopener noreferrer" class="update-link">
                <div class="update-meta">
                  <span class={`status status-${u.kind}`}>{LABELS[u.kind]}</span>
                  <time datetime={u.date.toISOString()}>{fmt(u.date)}</time>
                </div>
                <h2 class="update-title">{u.title}</h2>
                <div class="update-services">
                  {u.services.map((k) => <span class="service-tag">{serviceLabel[k]}</span>)}
                </div>
                {u.summary && <p class="update-summary">{u.summary}</p>}
                <span class="update-cta">Read on Azure Updates <Icon name="arrow-up-right" size={13} /></span>
              </a>
            </li>
          ))}
        </ol>
        <p class="no-results" data-updates-empty hidden>No updates match your filters.</p>
      </>
    )}
  </div>
</BaseLayout>

<script>
  function initUpdates() {
    const list = document.querySelector<HTMLElement>('[data-updates-list]');
    if (!list) return;
    const items = [...list.querySelectorAll<HTMLElement>('.update')];
    const kindButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const serviceButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-service]')];
    const search = document.querySelector<HTMLInputElement>('[data-updates-search]');
    const empty = document.querySelector<HTMLElement>('[data-updates-empty]');
    let kind = 'all';
    let service = 'all';

    const apply = () => {
      const q = (search?.value ?? '').trim().toLowerCase();
      let shown = 0;
      for (const item of items) {
        const visible =
          (kind === 'all' || item.dataset.kind === kind) &&
          (service === 'all' || item.dataset.services!.split(' ').includes(service)) &&
          (!q || item.dataset.text!.includes(q));
        item.hidden = !visible;
        if (visible) shown++;
      }
      if (empty) empty.hidden = shown > 0;
    };

    const bind = (buttons: HTMLButtonElement[], set: (v: string) => void, attr: string) => {
      for (const btn of buttons) {
        btn.addEventListener('click', () => {
          set(btn.getAttribute(attr) ?? 'all');
          buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
          apply();
        });
      }
    };
    bind(kindButtons, (v) => (kind = v), 'data-filter');
    bind(serviceButtons, (v) => (service = v), 'data-service');
    search?.addEventListener('input', apply);
  }
  document.addEventListener('astro:page-load', initUpdates);
</script>

<style>
  .updates-page { padding-top: 4rem; }
  .page-header { margin-bottom: 2.5rem; max-width: 760px; }
  .page-title {
    font-size: clamp(2.2rem, 5vw, 3.2rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin: 0.8rem 0 0.75rem;
  }
  .page-lede { color: var(--color-text-muted); margin: 0 0 1rem; line-height: 1.7; }
  .page-lede a { color: var(--color-primary); }
  .page-description {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin: 0;
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .filters { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .filter {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-bg-card);
    color: var(--color-text-muted);
    font: inherit;
    font-size: 0.85rem;
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s;
  }
  .filter:hover { color: var(--color-text); border-color: var(--color-border-strong); }
  .filter[aria-pressed='true'] {
    color: var(--color-on-primary);
    background: var(--gradient-button);
    border-color: transparent;
    font-weight: 600;
  }
  .services { margin-bottom: 1rem; }
  .filter-sm { padding: 0.35rem 0.8rem; font-size: 0.8rem; }
  .filter-count { font-family: var(--font-mono); font-size: 0.75rem; opacity: 0.75; }
  .search {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-bg-card);
    color: var(--color-text-muted);
    min-width: 240px;
  }
  .search:focus-within { border-color: var(--color-primary); }
  .search input {
    flex: 1;
    border: 0;
    background: transparent;
    color: var(--color-text);
    font: inherit;
    font-size: 0.9rem;
    outline: none;
  }

  .updates { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }
  .update[hidden] { display: none; }
  .update-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.4rem 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-card);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.2s, transform 0.2s;
  }
  .update-link:hover {
    border-color: color-mix(in srgb, var(--color-primary) 45%, var(--color-border));
    transform: translateY(-2px);
  }
  .update-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }
  .status {
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-pill);
    border: 1px solid currentColor;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.68rem;
  }
  .status-ga { color: var(--color-success); }
  .status-preview { color: var(--color-blue); }
  .status-retirement { color: var(--color-danger); }
  .status-update { color: var(--color-text-muted); }
  .update-title { font-size: 1.05rem; font-weight: 700; line-height: 1.4; margin: 0 0 0.6rem; }
  .update-services { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0 0 0.75rem; }
  .service-tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm);
    background: var(--color-tag-bg);
    color: var(--color-tag-text);
  }
  .update-summary { margin: 0 0 1rem; font-size: 0.9rem; line-height: 1.6; color: var(--color-text-muted); }
  .update-cta {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-primary);
  }
  .no-results, .empty { color: var(--color-text-muted); text-align: center; padding: 3rem 0; }
  .empty { display: grid; justify-items: center; gap: 1rem; }

  @media (max-width: 860px) {
    .updates { grid-template-columns: 1fr; }
    .search { min-width: 0; width: 100%; }
  }
</style>
