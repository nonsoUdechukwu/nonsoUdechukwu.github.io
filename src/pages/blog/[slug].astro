---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { AUTHOR, SITE } from '../../config';
import { formatDate, getPosts, readingTime, slugify, type Post } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}
const { post, newer, older } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, tags } = post.data;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const url = new URL(`/blog/${post.id}`, SITE.url).toString();
const shareX = `https://x.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(url)}&via=nonsoUdechukwu`;
const shareLinkedIn = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`;
---

<BaseLayout title={title} description={description} image={heroImage} type="article" publishedTime={pubDate}>
  <div class="reading-progress" id="readingProgress" aria-hidden="true"></div>

  <article class="blog-post" data-pagefind-body>
    {heroImage && (
      <div class="hero-image-wrapper">
        <img src={heroImage} alt="" class="hero-image" />
      </div>
    )}

    <div class="container--narrow post-container">
      <header class="post-header">
        <nav class="breadcrumb" aria-label="Breadcrumb" data-pagefind-ignore>
          <a href="/">~</a><span>/</span><a href="/blog">blog</a><span>/</span><span class="crumb-current">{post.id}</span>
        </nav>
        {tags.length > 0 && (
          <div class="post-tags">
            {tags.map((tag) => <a href={`/tags/${slugify(tag)}`} class="tag">{tag}</a>)}
          </div>
        )}
        <h1 class="post-title">{title}</h1>
        <p class="post-description">{description}</p>
        <div class="post-meta" data-pagefind-ignore>
          <div class="meta-author">
            <img src={AUTHOR.avatar} alt={AUTHOR.name} class="author-avatar" width="42" height="42" />
            <div class="author-info">
              <span class="author-name">{AUTHOR.name}</span>
              <div class="meta-details">
                <time datetime={pubDate.toISOString()}>{formatDate(pubDate, 'long')}</time>
                <span aria-hidden="true">·</span>
                <span>{readingTime(post.body)}</span>
                {updatedDate && (
                  <>
                    <span aria-hidden="true">·</span>
                    <span>Updated {formatDate(updatedDate)}</span>
                  </>
                )}
              </div>
            </div>
          </div>
        </div>
      </header>

      <div class="post-body prose">
        <Content />
      </div>

      <footer class="post-footer" data-pagefind-ignore>
        <div class="share-section">
          <div>
            <p class="share-label">Found this useful?</p>
            <p class="share-sub">Share it with your team.</p>
          </div>
          <div class="share-buttons">
            <a href={shareX} class="share-btn" target="_blank" rel="noopener noreferrer">
              <Icon name="x" size={14} /> X
            </a>
            <a href={shareLinkedIn} class="share-btn" target="_blank" rel="noopener noreferrer">
              <Icon name="linkedin" size={14} /> LinkedIn
            </a>
            <button type="button" class="share-btn" data-copy-link={url}>
              <Icon name="link" size={14} /> <span>Copy link</span>
            </button>
          </div>
        </div>

        {(newer || older) && (
          <nav class="post-nav" aria-label="More posts">
            {older ? (
              <a href={`/blog/${older.id}`} class="post-nav-link prev">
                <span class="post-nav-label"><Icon name="arrow-left" size={14} /> Previous</span>
                <span class="post-nav-title">{older.data.title}</span>
              </a>
            ) : <span></span>}
            {newer && (
              <a href={`/blog/${newer.id}`} class="post-nav-link next">
                <span class="post-nav-label">Next <Icon name="arrow-right" size={14} /></span>
                <span class="post-nav-title">{newer.data.title}</span>
              </a>
            )}
          </nav>
        )}

        <a href="/blog" class="back-link"><Icon name="arrow-left" size={14} /> Back to all posts</a>
      </footer>
    </div>

    {toc.length > 1 && (
      <aside class="toc-sidebar" aria-label="Table of contents" data-pagefind-ignore>
        <div class="toc-inner">
          <p class="toc-title">On this page</p>
          <ul class="toc-list">
            {toc.map((h) => (
              <li class={`toc-item toc-item--h${h.depth}`}>
                <a href={`#${h.slug}`} class="toc-link" data-toc-link={h.slug}>{h.text}</a>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    )}
  </article>
</BaseLayout>

<script>
  let cleanup: (() => void) | undefined;

  function initPost() {
    cleanup?.();
    cleanup = undefined;
    const body = document.querySelector<HTMLElement>('.post-body');
    if (!body) return;

    // Heading anchors
    body.querySelectorAll<HTMLElement>('h2[id], h3[id], h4[id]').forEach((h) => {
      if (h.querySelector('.heading-anchor')) return;
      const a = document.createElement('a');
      a.className = 'heading-anchor';
      a.href = `#${h.id}`;
      a.setAttribute('aria-label', 'Link to this section');
      a.textContent = '#';
      h.appendChild(a);
    });

    // Copy buttons for code blocks
    body.querySelectorAll<HTMLPreElement>('pre').forEach((pre) => {
      if (pre.parentElement?.classList.contains('code-wrapper')) return;
      const wrapper = document.createElement('div');
      wrapper.className = 'code-wrapper';
      pre.replaceWith(wrapper);
      wrapper.appendChild(pre);
      const lang = pre.dataset.language;
      if (lang && lang !== 'plaintext') {
        const label = document.createElement('span');
        label.className = 'code-lang';
        label.textContent = lang;
        wrapper.appendChild(label);
      }
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'copy-code-btn';
      btn.setAttribute('aria-label', 'Copy code');
      btn.textContent = 'Copy';
      btn.addEventListener('click', async () => {
        await navigator.clipboard.writeText(pre.querySelector('code')?.innerText ?? pre.innerText);
        btn.textContent = 'Copied!';
        btn.classList.add('copied');
        setTimeout(() => {
          btn.textContent = 'Copy';
          btn.classList.remove('copied');
        }, 2000);
      });
      wrapper.appendChild(btn);
    });

    // Copy link button
    document.querySelectorAll<HTMLButtonElement>('[data-copy-link]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        await navigator.clipboard.writeText(btn.dataset.copyLink ?? location.href);
        const label = btn.querySelector('span');
        btn.classList.add('copied');
        if (label) label.textContent = 'Copied!';
        setTimeout(() => {
          btn.classList.remove('copied');
          if (label) label.textContent = 'Copy link';
        }, 2000);
      });
    });

    // Reading progress + TOC
    const progress = document.getElementById('readingProgress');
    const toc = document.querySelector<HTMLElement>('.toc-sidebar');
    const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
    const targets = links
      .map((l) => document.getElementById(l.dataset.tocLink ?? ''))
      .filter((el): el is HTMLElement => !!el);

    const onScroll = () => {
      const rect = body.getBoundingClientRect();
      const total = rect.height - window.innerHeight;
      const pct = total > 0 ? Math.min(100, Math.max(0, (-rect.top / total) * 100)) : 0;
      if (progress) progress.style.width = `${pct}%`;
      toc?.classList.toggle('toc-visible', rect.top < 200);

      let current = targets[0]?.id;
      for (const t of targets) {
        if (t.getBoundingClientRect().top < 120) current = t.id;
      }
      links.forEach((l) => l.classList.toggle('active', l.dataset.tocLink === current));
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
    cleanup = () => window.removeEventListener('scroll', onScroll);
  }

  document.addEventListener('astro:page-load', initPost);
  document.addEventListener('astro:before-swap', () => {
    cleanup?.();
    cleanup = undefined;
  });
</script>

<style>
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 2px;
    width: 0%;
    background: var(--gradient-brand);
    box-shadow: 0 0 12px var(--color-primary);
    z-index: 200;
    transition: width 0.1s linear;
  }
  .hero-image-wrapper {
    max-width: 1040px;
    margin: 2.5rem auto 0;
    padding: 0 1.5rem;
  }
  .hero-image {
    width: 100%;
    aspect-ratio: 2 / 1;
    object-fit: cover;
    border-radius: var(--radius-xl);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-lg);
  }
  .post-container { padding-top: 3rem; }
  .post-header {
    position: relative;
    margin-bottom: 2.75rem;
    padding-bottom: 2rem;
  }
  .post-header::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: linear-gradient(90deg, var(--color-primary), var(--color-border) 35%, transparent);
  }
  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }
  .breadcrumb a { color: var(--color-text-muted); }
  .breadcrumb a:hover { color: var(--color-primary); }
  .crumb-current { color: var(--color-primary); }
  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.25rem;
  }
  .post-title {
    font-size: clamp(2rem, 4.6vw, 3rem);
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -0.03em;
    margin-bottom: 1.1rem;
  }
  .post-description {
    color: var(--color-text-muted);
    font-size: 1.15rem;
    margin-bottom: 1.75rem;
  }
  .post-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .meta-author {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }
  .author-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    padding: 2px;
    background: var(--gradient-brand);
  }
  .author-info {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .author-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
  }
  .meta-details {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .post-body {
    font-size: 1.07rem;
    line-height: 1.85;
    max-width: none;
  }
  .post-body :global(.heading-anchor) {
    display: inline-block;
    margin-left: 0.45rem;
    font-family: var(--font-mono);
    color: var(--color-primary);
    text-decoration: none;
    opacity: 0;
    transition: opacity var(--transition);
  }
  .post-body :global(h2:hover .heading-anchor),
  .post-body :global(h3:hover .heading-anchor),
  .post-body :global(h4:hover .heading-anchor),
  .post-body :global(.heading-anchor:focus) { opacity: 0.8; }
  .post-body :global(h2),
  .post-body :global(h3),
  .post-body :global(h4) { scroll-margin-top: 92px; }

  .post-body :global(.code-wrapper) {
    position: relative;
    margin: 1.75rem 0;
  }
  .post-body :global(.code-wrapper pre) {
    margin: 0;
    padding-top: 3rem;
  }
  .post-body :global(.code-wrapper)::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2.1rem;
    border-bottom: 1px solid var(--color-border);
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    background: color-mix(in srgb, var(--color-bg-secondary) 80%, transparent);
    pointer-events: none;
    z-index: 1;
  }
  .post-body :global(.code-lang) {
    position: absolute;
    top: 0.5rem;
    left: 1rem;
    z-index: 2;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-primary);
    pointer-events: none;
  }
  .post-body :global(.copy-code-btn) {
    position: absolute;
    top: 0.3rem;
    right: 0.5rem;
    z-index: 2;
    padding: 0.18rem 0.65rem;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    cursor: pointer;
    transition: all var(--transition);
  }
  .post-body :global(.copy-code-btn:hover) {
    color: var(--color-primary);
    border-color: var(--color-primary);
  }
  .post-body :global(.copy-code-btn.copied) {
    color: var(--color-success);
    border-color: var(--color-success);
  }

  .post-footer {
    margin-top: 3.5rem;
  }
  .share-section {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    flex-wrap: wrap;
    padding: 1.5rem 1.75rem;
    margin-bottom: 2rem;
    background:
      radial-gradient(ellipse at 100% 0%, color-mix(in srgb, var(--color-primary) 14%, transparent), transparent 60%),
      var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
  }
  .share-label {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    margin: 0;
  }
  .share-sub {
    color: var(--color-text-muted);
    font-size: 0.88rem;
    margin: 0;
  }
  .share-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .share-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 1rem;
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    border: 1px solid var(--color-border-strong);
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
    transition: all var(--transition);
  }
  .share-btn:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
    box-shadow: var(--glow);
  }
  .share-btn.copied {
    border-color: var(--color-success);
    color: var(--color-success);
  }

  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .post-nav-link {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: 1.2rem 1.4rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--color-bg-card) 75%, transparent);
    transition: all var(--transition);
  }
  .post-nav-link:hover {
    border-color: var(--color-primary);
    box-shadow: var(--glow);
  }
  .post-nav-link.next {
    text-align: right;
    grid-column: 2;
  }
  .post-nav-label {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-primary);
  }
  .next .post-nav-label { justify-content: flex-end; }
  .post-nav-title {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.4;
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .back-link:hover { color: var(--color-primary); }

  .toc-sidebar {
    position: fixed;
    top: 110px;
    right: max(1.5rem, calc((100vw - 780px) / 2 - 280px));
    width: 230px;
    max-height: calc(100vh - 140px);
    overflow-y: auto;
    display: none;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }
  .toc-sidebar.toc-visible {
    opacity: 1;
    pointer-events: auto;
  }
  .toc-title {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-primary);
    margin-bottom: 0.9rem;
  }
  .toc-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    border-left: 1px solid var(--color-border);
  }
  .toc-link {
    display: block;
    margin-left: -1px;
    padding: 0.32rem 0 0.32rem 0.95rem;
    border-left: 2px solid transparent;
    font-size: 0.84rem;
    line-height: 1.45;
    color: var(--color-text-muted);
    transition: all var(--transition);
  }
  .toc-item--h3 .toc-link {
    padding-left: 1.7rem;
    font-size: 0.8rem;
  }
  .toc-link:hover { color: var(--color-text); }
  .toc-link.active {
    color: var(--color-primary);
    border-left-color: var(--color-primary);
  }

  @media (min-width: 1360px) {
    .toc-sidebar { display: block; }
  }
  @media (max-width: 640px) {
    .post-nav { grid-template-columns: 1fr; }
    .post-nav-link.next { grid-column: 1; }
    .share-section { padding: 1.25rem; }
  }
</style>
