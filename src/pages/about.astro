---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { AUTHOR, SOCIALS } from '../config';
import { ABOUT, CERTIFICATIONS, SKILLS } from '../data/about';

const links = [
  { href: SOCIALS.github, label: 'GitHub', icon: 'github' },
  { href: SOCIALS.linkedin, label: 'LinkedIn', icon: 'linkedin' },
  { href: SOCIALS.x, label: 'X / Twitter', icon: 'x' },
  { href: SOCIALS.email, label: 'Email', icon: 'email' },
];
---

<BaseLayout title="About" description={`About ${AUTHOR.name} — ${AUTHOR.role}.`}>
  <div class="container--narrow about-page">
    <section class="about-hero">
      <img src={AUTHOR.avatar} alt={AUTHOR.name} class="about-avatar" width="96" height="96" />
      <div class="about-hero-content">
        <h1 class="about-name">{AUTHOR.name}</h1>
        <p class="about-role">{AUTHOR.role}</p>
        <div class="about-badges">
          {ABOUT.badges.map((b) => <span class="about-badge">{b}</span>)}
        </div>
        <p class="about-location">
          <Icon name="map-pin" size={14} /> {AUTHOR.location}
        </p>
        <div class="about-links">
          {links.map((l) => (
            <a href={l.href} class="btn btn-secondary btn-sm" {...(l.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
              <Icon name={l.icon} size={14} /> {l.label}
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="about-section">
      <h2 class="section-heading">About Me</h2>
      <div class="prose about-text">
        {ABOUT.paragraphs.map((p) => <p set:html={p} />)}
      </div>
    </section>

    <section class="about-section">
      <h2 class="section-heading">Technical Skills</h2>
      <div class="skills-grid">
        {SKILLS.map((group) => (
          <div class="skill-group">
            <h3 class="skill-category">{group.category}</h3>
            <ul class="skill-list">
              {group.items.map((item) => (
                <li class="skill-item">
                  <span class="skill-dot" aria-hidden="true"></span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    {CERTIFICATIONS.length > 0 && (
      <section class="about-section">
        <h2 class="section-heading">Certifications</h2>
        <div class="cert-group">
          <ul class="certs-list">
            {CERTIFICATIONS.map((c) => (
              <li class="cert-item">
                <span class="cert-badge" style={`border-color:${c.color ?? 'var(--color-primary)'}`}>
                  <span class="cert-code">{c.code}</span>
                </span>
                <span class="cert-name">{c.name}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    <section class="about-section">
      <h2 class="section-heading">Get In Touch</h2>
      <div class="contact-card">
        <p>
          Have a question, want to collaborate, or just want to talk Azure and DevOps? I'm always happy to connect with
          fellow engineers.
        </p>
        <div class="contact-actions">
          <a href={SOCIALS.email} class="btn btn-primary"><Icon name="email" size={16} /> Send an Email</a>
          <a href={SOCIALS.linkedin} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
            <Icon name="linkedin" size={16} /> Connect on LinkedIn
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .about-page { padding: 3rem 1.5rem 0; }
  .about-hero {
    display: flex;
    align-items: center;
    gap: 2rem;
    padding: 2.5rem;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    margin-bottom: 3rem;
    position: relative;
    overflow: hidden;
  }
  .about-hero::before {
    content: '';
    position: absolute;
    top: -80px;
    right: -80px;
    width: 240px;
    height: 240px;
    border-radius: 50%;
    background: var(--color-primary);
    opacity: 0.08;
    pointer-events: none;
  }
  .about-avatar {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    border: 3px solid var(--color-border);
  }
  .about-hero-content { flex: 1; position: relative; }
  .about-name {
    font-size: 1.75rem;
    margin-bottom: 0.25rem;
  }
  .about-role {
    color: var(--color-primary);
    font-weight: 600;
    margin-bottom: 0.75rem;
    font-size: 1rem;
  }
  .about-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }
  .about-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.25rem 0.7rem;
    background: var(--color-tag-bg);
    color: var(--color-tag-text);
    border-radius: 100px;
    font-size: 0.78rem;
    font-weight: 600;
  }
  .about-location {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    margin-bottom: 1.25rem;
  }
  .about-links {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .btn-sm {
    padding: 0.35rem 0.85rem;
    font-size: 0.8rem;
  }
  .about-section { margin-bottom: 3rem; }
  .section-heading {
    font-size: 1.5rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border);
  }
  .about-text {
    max-width: none;
    font-size: 1.05rem;
    line-height: 1.8;
  }
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }
  .skill-group {
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.25rem;
  }
  .skill-category {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    margin-bottom: 0.85rem;
  }
  .skill-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .skill-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
  }
  .skill-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-primary);
    flex-shrink: 0;
  }
  .cert-group {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .certs-list { list-style: none; }
  .cert-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 1.25rem;
    border-bottom: 1px solid var(--color-border);
  }
  .cert-item:last-child { border-bottom: none; }
  .cert-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.2rem 0.55rem;
    border: 1px solid;
    border-radius: var(--radius-sm);
    flex-shrink: 0;
    min-width: 5rem;
  }
  .cert-code {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    white-space: nowrap;
  }
  .cert-name {
    font-size: 0.9rem;
    font-weight: 500;
  }
  .contact-card {
    padding: 2rem;
    background: linear-gradient(135deg, var(--color-bg-secondary) 0%, var(--color-bg-card) 100%);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
  }
  .contact-card p { color: var(--color-text-muted); }
  .contact-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 1.25rem;
  }

  @media (max-width: 640px) {
    .about-hero {
      flex-direction: column;
      text-align: center;
      padding: 2rem 1.5rem;
    }
    .about-badges,
    .about-location,
    .about-links { justify-content: center; }
    .skills-grid { grid-template-columns: 1fr; }
  }
</style>
