---
import { AUTHOR, SITE, SOCIALS, TOPICS } from '../config';
import Icon from './Icon.astro';
import Logo from './Logo.astro';

const year = new Date().getFullYear();
const socials = [
  { href: SOCIALS.x, label: 'X / Twitter', icon: 'x' },
  { href: SOCIALS.github, label: 'GitHub', icon: 'github' },
  { href: SOCIALS.linkedin, label: 'LinkedIn', icon: 'linkedin' },
  { href: SOCIALS.email, label: 'Email', icon: 'email' },
  { href: '/rss.xml', label: 'RSS feed', icon: 'rss' },
];
---

<footer class="site-footer">
  <div class="footer-signature">
    <div class="container signature-inner">
      <img src="/images/logo-eye.jpg" alt="" class="signature-eye" width="900" height="650" loading="lazy" aria-hidden="true" />
      <p class="signature-name">{AUTHOR.fullName}</p>
      <p class="signature-tagline">{AUTHOR.role}</p>
    </div>
  </div>

  <div class="container footer-inner">
    <div class="footer-brand">
      <Logo />
      <p class="footer-tagline">{AUTHOR.bio}</p>
      <div class="social-links">
        {socials.map((s) => (
          <a
            href={s.href}
            class="social-link"
            aria-label={s.label}
            title={s.label}
            {...(s.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            <Icon name={s.icon} size={17} />
          </a>
        ))}
      </div>
    </div>

    <div class="footer-links">
      <div>
        <h3 class="footer-heading">Explore</h3>
        <ul class="footer-nav">
          <li><a href="/">Home</a></li>
          <li><a href="/blog">Blog</a></li>
          <li><a href="/tags">Tags</a></li>
          <li><a href="/about">About</a></li>
        </ul>
      </div>
      <div>
        <h3 class="footer-heading">Topics</h3>
        <ul class="footer-nav">
          {TOPICS.slice(0, 5).map((t) => (
            <li><a href={`/tags/${t.tag}`}>{t.name}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h3 class="footer-heading">Feeds</h3>
        <ul class="footer-nav">
          <li><a href="/rss.xml">RSS Feed</a></li>
          <li><a href="/sitemap-index.xml">Sitemap</a></li>
          <li><a href={SOCIALS.github} target="_blank" rel="noopener noreferrer">GitHub</a></li>
        </ul>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container">
      <p>&copy; {year} {AUTHOR.fullName}</p>
      <p class="footer-status"><span class="status-dot"></span> {SITE.title} · built with <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a></p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    margin-top: 5rem;
    background: var(--color-bg-secondary);
    border-top: 1px solid var(--color-border);
  }
  .footer-signature {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
    background: radial-gradient(ellipse 60% 120% at 50% 0%, var(--bg-glow), transparent 70%);
  }
  .signature-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 3rem 1.5rem 2.5rem;
  }
  .signature-eye {
    width: 120px;
    height: auto;
    border-radius: 50%;
    aspect-ratio: 1;
    object-fit: cover;
    margin-bottom: 1.25rem;
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--color-primary) 40%, transparent), 0 0 60px -10px var(--color-primary);
  }
  .signature-name {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 3.2vw, 1.9rem);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text);
    margin-bottom: 0.4rem;
  }
  .signature-tagline {
    font-family: var(--font-display);
    font-size: clamp(0.7rem, 1.6vw, 0.9rem);
    font-weight: 600;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    margin: 0;
    background: var(--gradient-brand);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .footer-inner {
    display: grid;
    grid-template-columns: 1.1fr 1.4fr;
    gap: 3rem;
    padding: 3rem 1.5rem;
  }
  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }
  .footer-tagline {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    max-width: 38ch;
    margin: 0;
  }
  .social-links {
    display: flex;
    gap: 0.5rem;
  }
  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    color: var(--color-text-muted);
    transition: all var(--transition);
  }
  .social-link:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
    box-shadow: var(--glow);
    transform: translateY(-2px);
  }
  .footer-links {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }
  .footer-heading {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-primary);
    margin-bottom: 1rem;
  }
  .footer-nav {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .footer-nav a {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    text-decoration: none;
    transition: color var(--transition), padding var(--transition);
  }
  .footer-nav a:hover { color: var(--color-text); padding-left: 0.3rem; }
  .footer-bottom {
    border-top: 1px solid var(--color-border);
    padding: 1.1rem 0;
  }
  .footer-bottom .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .footer-bottom p {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    margin: 0;
  }
  .footer-status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-success);
    box-shadow: 0 0 8px var(--color-success);
    animation: pulse 2.4s infinite;
  }

  @media (max-width: 768px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 2.25rem;
      padding: 2.5rem 1.5rem;
    }
    .footer-links { grid-template-columns: 1fr 1fr; }
  }
</style>
