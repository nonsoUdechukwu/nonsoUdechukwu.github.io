---
import Icon from './Icon.astro';
import { formatDate, readingTime, slugify, type Post } from '../utils/posts';

interface Props {
  post: Post;
  featured?: boolean;
}
const { post, featured = false } = Astro.props;
const { title, description, pubDate, heroImage, tags } = post.data;
const href = `/blog/${post.id}`;
---

<article class:list={['blog-card', { 'blog-card--featured': featured, 'has-image': !!heroImage }]}>
  {heroImage && (
    <a href={href} class="card-image" tabindex="-1" aria-hidden="true">
      <img src={heroImage} alt="" loading="lazy" />
    </a>
  )}
  <div class="card-content">
    <div class="card-meta">
      <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
      <span class="meta-sep" aria-hidden="true">//</span>
      <span>{readingTime(post.body)}</span>
    </div>
    <h3 class="card-title">
      <a href={href}>{title}</a>
    </h3>
    <p class="card-description">{description}</p>
    <div class="card-footer">
      {tags.length > 0 && (
        <div class="card-tags">
          {tags.slice(0, featured ? 4 : 3).map((tag) => <a href={`/tags/${slugify(tag)}`} class="tag">{tag}</a>)}
        </div>
      )}
      <a href={href} class="card-read" aria-label={`Read ${title}`}>
        <Icon name="arrow-up-right" size={18} />
      </a>
    </div>
  </div>
</article>

<style>
  .blog-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    background: linear-gradient(180deg, var(--color-bg-card), color-mix(in srgb, var(--color-bg-card) 80%, var(--color-bg)));
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    transition: border-color var(--transition), transform var(--transition), box-shadow var(--transition);
  }
  .blog-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--gradient-brand);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.45s ease;
    z-index: 1;
  }
  .blog-card:hover {
    border-color: color-mix(in srgb, var(--color-primary) 45%, var(--color-border));
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg), 0 0 40px -20px var(--color-primary);
  }
  .blog-card:hover::before { transform: scaleX(1); }

  .card-image {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
  }
  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .blog-card:hover .card-image img { transform: scale(1.04); }

  .card-content {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.6rem;
    flex: 1;
  }
  .card-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .meta-sep { color: var(--color-primary); opacity: 0.7; }
  .card-title {
    font-size: 1.2rem;
    line-height: 1.35;
    margin: 0;
  }
  .card-title a {
    color: var(--color-text);
    text-decoration: none;
    background: linear-gradient(var(--color-primary), var(--color-primary)) 0 100% / 0 1px no-repeat;
    transition: background-size 0.35s ease, color var(--transition);
  }
  .card-title a:hover {
    color: var(--color-primary);
    background-size: 100% 1px;
  }
  .card-description {
    color: var(--color-text-muted);
    font-size: 0.92rem;
    line-height: 1.65;
    margin: 0;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-footer {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.4rem;
    padding-top: 1rem;
    border-top: 1px dashed var(--color-border);
  }
  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .card-read {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    margin-left: auto;
    border-radius: 50%;
    border: 1px solid var(--color-border-strong);
    color: var(--color-text-muted);
    transition: all var(--transition);
  }
  .blog-card:hover .card-read {
    background: var(--gradient-button);
    border-color: transparent;
    color: var(--color-on-primary);
    transform: rotate(45deg);
  }

  /* Featured: wide, two-column layout */
  .blog-card--featured .card-content { padding: 2.25rem; gap: 1rem; }
  .blog-card--featured .card-title { font-size: clamp(1.4rem, 3vw, 1.9rem); }
  .blog-card--featured .card-description { font-size: 1rem; -webkit-line-clamp: 4; }
  @media (min-width: 900px) {
    .blog-card--featured.has-image {
      display: grid;
      grid-template-columns: 1.1fr 1fr;
    }
    .blog-card--featured.has-image .card-image {
      aspect-ratio: auto;
      height: 100%;
      border-bottom: none;
      border-right: 1px solid var(--color-border);
    }
  }
</style>
