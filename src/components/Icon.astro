const isFilled = name in filled;
const viewBox = isFilled ? (filled[name].viewBox ?? '0 0 24 24') : '0 0 24 24';
---

{isFilled ? (
  <svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox={viewBox} fill="currentColor" class={className} aria-hidden="true">
    <path d={filled[name].d} />
  </svg>
) : (
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width={size}
    height={size}
    viewBox={viewBox}
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class={className}
    aria-hidden="true"
    set:html={stroked[name] ?? ''}
